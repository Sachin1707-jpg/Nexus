# Copy to .env (in the project root) and fill in. Never commit .env.
PORT=8787
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
TIMEZONE=Asia/Kolkata

# Secrets (generate long random values; PowerShell: [guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N'))
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Bearer token required by the MCP endpoint (/mcp). Needed by external MCP clients such as Alexa+.
MCP_AUTH_TOKEN=

# Local model (free). Fast default; thinking is off for speed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_THINK=false

# Google (Tasks, Calendar, Gmail): create an OAuth "Web application" client in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# GitHub fine-grained token. Start with read-only (Contents: read, Metadata: read).
GITHUB_TOKEN=

# Weather default place (optional; can also be set in Settings)
DEFAULT_LOCATION=

# Folders Nexus may scan/delete in, separated by semicolons. Empty = file tools disabled.
# Example: C:\Users\you\Downloads;D:\Temp
APPROVED_DIRS=

# Optional local speech-to-text service
WHISPER_URL=http://127.0.0.1:8788

# Optional News API Key
NEWS_API_KEY=

# Optional Gemini API (replaces Ollama for assistant + voice STT fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
